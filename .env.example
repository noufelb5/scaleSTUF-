# Leave provider settings empty to explore research and draft review locally.
WORKSPACE_PASSWORD=
# DATABASE_URL=postgresql+psycopg://user:password@host/database

# A mailbox you control. All outbound sends are restricted to this address.
CONTROLLED_RECIPIENT=
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Dedicated Google Calendar. OAuth scopes must permit free/busy and event writes.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional Chat Input -> model -> Chat Output flow.
LANGFLOW_RUN_URL=
LANGFLOW_API_KEY=


# Optional live prospect research. Set WORKSPACE_PASSWORD when enabling this.
OPENAI_API_KEY=
# OPENAI_RESEARCH_MODEL=gpt-5-mini
