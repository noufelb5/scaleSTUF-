# Set to 1 for a local simulation with its own SQLite database.
LEDGERWISE_DEMO=0
# Optional passwordless simulation for a direct loopback connection only.
LEDGERWISE_LOCAL_DEMO=0
# Required outside the explicit local simulation.
WORKSPACE_PASSWORD=

# Live prospect discovery. Set a workspace password when enabling this key.
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-5-mini
# DATABASE_URL=postgresql+psycopg://user:password@host/database

# A mailbox you control. All outbound sends are restricted to this address.
CONTROLLED_RECIPIENT=
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Dedicated Google Calendar. OAuth scopes must permit free/busy and event writes.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional Chat Input -> model -> Chat Output flow.
LANGFLOW_RUN_URL=
LANGFLOW_API_KEY=

